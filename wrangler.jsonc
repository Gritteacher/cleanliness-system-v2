{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "colorteam-activities",
  "account_id": "36723824247462632e940a959a4b77d8",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{"pattern":"colorteam.gritspace.cc/*","zone_id":"21f909058b04133ce53107da2d72ec61"}],
  "minify": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/.netlify/functions/*"]
  },
  "browser": {"binding": "BROWSER"},
  "rules": [{"type": "Data", "globs": ["**/*.ttf"], "fallthrough": true}],
  "alias": {
    "@sparticuz/chromium": "./worker/native-browser-unavailable.mjs",
    "playwright-core": "./worker/native-browser-unavailable.mjs"
  },
  "ratelimits": [{"name":"API_LIMITER","namespace_id":"1001","simple":{"limit":6,"period":60}}],
  "vars": {
    "FREE_PLAN_CONFIRMED": "true",
    "ENABLE_DAILY_EMAIL": "false",
    "PUBLIC_SITE_URL": "https://colorteam.gritspace.cc"
  }
}
